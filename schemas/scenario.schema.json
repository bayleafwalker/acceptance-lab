{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kotona.app/schemas/acceptance-lab/scenario.schema.json",
  "title": "Acceptance Lab scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "workload",
    "checks"
  ],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "workload": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "inputs": {"type": "object"},
    "metadata": {"type": "object"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/check"}
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "dimension"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "dimension": {
          "enum": ["mechanism", "quality", "authority", "economics"]
        },
        "threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "hard_gate": {"type": "boolean"},
        "params": {
          "type": "object",
          "description": "Scorer-specific parameters. A list-valued parameter is the subject the check is about, and an empty one is refused: a check that declares nothing is satisfied by every candidate, and scores 1.000 for a run that demonstrated nothing.",
          "additionalProperties": {"not": {"type": "array", "maxItems": 0}}
        }
      }
    }
  }
}

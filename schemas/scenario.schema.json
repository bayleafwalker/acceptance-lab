{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kotona.app/schemas/acceptance-lab/scenario.schema.json",
  "title": "Acceptance Lab scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "workload",
    "checks"
  ],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "workload": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "inputs": {"type": "object"},
    "metadata": {"type": "object"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/check"}
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "dimension"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "dimension": {
          "enum": ["mechanism", "quality", "authority", "economics"]
        },
        "threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "hard_gate": {"type": "boolean"},
        "params": {"type": "object"}
      }
    }
  }
}
